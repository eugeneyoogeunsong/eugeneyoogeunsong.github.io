{%- comment -%}
  LinkedIn profile badge, large + horizontal.

  Usage:
    {% include linkedin_badge.liquid %}
        renders in place (ordinary content pages).

    {% include linkedin_badge.liquid before_heading="selected publications" %}
        renders in place, then moves itself above the heading whose text
        matches. Needed on About, where News and Selected Publications are
        emitted by the gem-owned layout *after* the page content.

    {% include linkedin_badge.liquid before=".social" %}
        same, but positions against a CSS selector.

    {% include linkedin_badge.liquid append_to=".post" %}
        appends as the last child of the first match. For pages whose body the
        layout generates (the CV), where markdown position is not the bottom.

    {% include linkedin_badge.liquid after_heading="references" %}
        moves itself BELOW the whole section introduced by that heading, by
        appending to the heading's parent. For project pages with
        related_publications: true, where the gem emits the References list
        after the page content and the badge would otherwise sit above it.
        Structure-agnostic: it does not care how the reference list is marked
        up, only which container the heading lives in.

  IMPORTANT, and the reason this file looks the way it does:

    profile.js must be a STATIC script tag. It renders the badge from its own
    DOMContentLoaded listener, so if it is injected from inside another
    DOMContentLoaded handler it loads after that event has already fired, its
    listener never runs, and the badge stays as the bare fallback link. That
    is exactly what happened when this was dynamically injected.

    Consequences of that constraint:
      - the theme is set by an inline script that runs during parse, before
        profile.js initialises (LinkedIn reads data-theme once, at init);
      - repositioning happens on DOMContentLoaded, i.e. possibly after the
        badge has rendered. Moving the node is safe: the iframe moves with it.
      - the wrapper is never hidden. If the repositioning fails, a badge in
        the wrong place beats an invisible one.
{%- endcomment -%}

<div class="li-badge-wrap" id="li-badge-wrap">
  <div
    class="badge-base LI-profile-badge"
    data-locale="en_US"
    data-size="large"
    data-theme="light"
    data-type="HORIZONTAL"
    data-vanity="yoogeunsong"
    data-version="v1"
  >
    <a class="badge-base__link LI-simple-link" href="https://uk.linkedin.com/in/yoogeunsong?trk=profile-badge">Eugene (Yoogeun) Song</a>
  </div>
</div>

<style>
  .li-badge-wrap {
    display: flex;
    justify-content: center;
    margin: 2rem 0 1.5rem;
  }
</style>

<script>
  // Runs during parse, so it lands before profile.js initialises.
  (function () {
    var badge = document.querySelector('#li-badge-wrap .LI-profile-badge');
    if (!badge) return;
    var dark = document.documentElement.getAttribute('data-theme') === 'dark';
    badge.setAttribute('data-theme', dark ? 'dark' : 'light');
  })();
</script>

<script src="https://platform.linkedin.com/badges/js/profile.js" async defer type="text/javascript"></script>

<script>
  // Repositioning only. Safe to run after the badge has rendered.
  (function () {
    var MOVE_BEFORE = {{ include.before | default: "" | jsonify }};
    var BEFORE_HEADING = {{ include.before_heading | default: "" | jsonify }};
    var AFTER_HEADING = {{ include.after_heading | default: "" | jsonify }};
    var APPEND_TO = {{ include.append_to | default: "" | jsonify }};
    if (!MOVE_BEFORE && !BEFORE_HEADING && !AFTER_HEADING && !APPEND_TO) return;

    function headingByText(text) {
      var want = text.trim().toLowerCase();
      var hs = document.querySelectorAll(".post h1, .post h2, .post h3, h1, h2, h3");
      for (var i = 0; i < hs.length; i++) {
        if (hs[i].textContent.trim().toLowerCase() === want) return hs[i];
      }
      return null;
    }

    function reposition() {
      var wrap = document.getElementById("li-badge-wrap");
      if (!wrap) return;

      // "After" is handled first and separately: it appends to the heading's
      // PARENT, so the badge lands below every sibling that follows the
      // heading, i.e. below the whole reference list rather than just below
      // the heading itself.
      if (AFTER_HEADING) {
        var h = headingByText(AFTER_HEADING);
        if (h && h.parentNode) {
          h.parentNode.appendChild(wrap);
          return;
        }
        // No such heading on this page: leave the badge where the markdown put it.
      }

      var target = null;
      if (BEFORE_HEADING) target = headingByText(BEFORE_HEADING);
      if (!target && MOVE_BEFORE) {
        var sels = MOVE_BEFORE.split(",");
        for (var i = 0; i < sels.length; i++) {
          target = document.querySelector(sels[i].trim());
          if (target) break;
        }
      }
      if (target && target.parentNode) {
        target.parentNode.insertBefore(wrap, target);
        return;
      }
      if (APPEND_TO) {
        var container = null;
        var cs = APPEND_TO.split(",");
        for (var k = 0; k < cs.length; k++) {
          container = document.querySelector(cs[k].trim());
          if (container) break;
        }
        if (container) container.appendChild(wrap);
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", reposition);
    } else {
      reposition();
    }
  })();
</script>
