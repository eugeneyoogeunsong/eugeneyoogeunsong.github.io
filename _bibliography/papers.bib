@article{song2026sgra,
  abbr        = {In prep.},
  bibtex_show = {true},
  title       = {Multi-wavelength variability of {Sagittarius A*} from {GRMHD} simulations with electron heating},
  author      = {Song, Yoogeun and Younsi, Ziri and Mizuno, Yosuke and Wu, Kinwah and Fromm, Christian M.},
  journal     = mnras,
  year        = {2026},
  note        = {Draft in preparation},
  abstract    = {General-relativistic magnetohydrodynamic (BHAC) simulations of magnetically arrested discs, post-processed with general-relativistic radiative transfer (BHOSS), are used to model the multi-wavelength variability of Sgr A*. We compare electron-heating prescriptions (R-beta, turbulent, and magnetic-reconnection heating) across black hole spins a = -0.94 to +0.94 and assess their observational signatures.},
  preview     = {projects/sgra.jpg},
  selected    = {true},
  additional_info = {. Work carried out at UCL/MSSL with Dr Ziri Younsi and Prof Kinwah Wu.}
}

