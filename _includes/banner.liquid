{%- comment -%}
  Full-width banner image with an optional caption.

  Usage:
    {% include banner.liquid src="/assets/img/london/thames-wide.jpg"
                             alt="The Thames at dusk"
                             w="1600" h="640"
                             caption="London, where I am based." %}

  Params
    src      image path (root-relative)
    alt      alt text; required for anything that carries meaning
    w, h     intrinsic pixel size. Always pass these: they reserve the box
             before the image loads, so the page does not jump. Cumulative
             Layout Shift is the one Core Web Vital a banner can easily wreck.
    caption  optional line beneath
    eager    pass "true" for an above-the-fold banner so it is not lazy-loaded
             (a lazy LCP image delays Largest Contentful Paint)
    maxw     cap the rendered width in px and centre the figure. Use this for a
             portrait or square image shown whole: at full container width a 4:5
             frame would run well over 1000px tall and swamp the page.

  Classes and tags only, no attribute selectors: PurgeCSS strips those.
{%- endcomment -%}

<figure
  class="pic-banner{% if include.maxw %} pic-banner-capped{% endif %}"
  {% if include.maxw %}
    style="max-width:{{ include.maxw }}px"
  {% endif %}
>
  <img
    src="{{ include.src | relative_url }}"
    alt="{{ include.alt }}"
    width="{{ include.w }}"
    height="{{ include.h }}"
    {% if include.eager == 'true' %}
      fetchpriority="high"
    {% else %}
      loading="lazy" decoding="async"
    {% endif %}
  >
  {%- if include.caption %}
    <figcaption class="pic-banner-cap">{{ include.caption }}</figcaption>
  {%- endif %}
</figure>

<style>
  .pic-banner {
    margin: 1.75rem 0 2rem;
  }
  /* Capped variant: the inline max-width comes from the `maxw` param, and this
     centres it. Used where the whole frame must be visible rather than cropped
     to a letterbox. */
  .pic-banner-capped {
    margin-left: auto;
    margin-right: auto;
  }
  .pic-banner img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    /* aspect-ratio from the attributes keeps the reserved box correct as the
       image scales down on narrow screens */
    background: var(--global-card-bg-color);
  }
  .pic-banner-cap {
    margin-top: 0.6rem;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--global-text-color-light);
  }

  @media (max-width: 576px) {
    .pic-banner img {
      border-radius: 7px;
    }
    .pic-banner-cap {
      font-size: 0.8rem;
    }
  }
</style>
