{%- comment -%}
  LinkedIn profile badge, large + horizontal.

  Usage:
    {% include linkedin_badge.liquid %}
        renders in place (use on ordinary content pages).

    {% include linkedin_badge.liquid before_heading="selected publications" %}
        renders in place, then moves itself to just above the heading whose
        text matches. Needed on the About page, where News and Selected
        Publications are emitted by the gem-owned layout *after* the page
        content, so markdown position alone cannot put the badge above them.

        Matching on heading *text* rather than on the heading's link matters:
        news_heading_link.liquid rewrites the News anchor's href to LinkedIn,
        so a selector like a[href$="/news/"] would already be stale by the
        time this runs.

    {% include linkedin_badge.liquid before=".social" %}
        same idea, but positions against a CSS selector instead.

    {% include linkedin_badge.liquid append_to=".post" %}
        appends the badge as the last child of the first matching element.
        Use on pages whose body is generated by the layout (the CV), where
        there is no heading to sit above and the markdown position is not the
        bottom of what the reader sees.

  Two things learned the hard way elsewhere in this repo:
    - wait for DOMContentLoaded, or the target element does not exist yet;
    - LinkedIn reads data-theme once at init, so set it before loading the
      script rather than after, otherwise a light card lands on a dark page.
{%- endcomment -%}

<div class="li-badge-wrap" id="li-badge-wrap" hidden>
  <div
    class="badge-base LI-profile-badge"
    data-locale="en_US"
    data-size="large"
    data-theme="light"
    data-type="HORIZONTAL"
    data-vanity="yoogeunsong"
    data-version="v1"
  >
    <a class="badge-base__link LI-simple-link" href="https://uk.linkedin.com/in/yoogeunsong?trk=profile-badge">Eugene (Yoogeun) Song</a>
  </div>
</div>

<style>
  .li-badge-wrap {
    display: flex;
    justify-content: center;
    margin: 2rem 0 1.5rem;
  }
  .li-badge-wrap[hidden] {
    display: none;
  }
</style>

<script>
  (function () {
    var MOVE_BEFORE = {{ include.before | default: "" | jsonify }};
    var BEFORE_HEADING = {{ include.before_heading | default: "" | jsonify }};
    var APPEND_TO = {{ include.append_to | default: "" | jsonify }};

    // Find a heading by its visible text, ignoring case and any anchor markup
    // the theme wraps around it.
    function headingByText(text) {
      var want = text.trim().toLowerCase();
      var hs = document.querySelectorAll(".post h1, .post h2, .post h3, h1, h2, h3");
      for (var i = 0; i < hs.length; i++) {
        if (hs[i].textContent.trim().toLowerCase() === want) return hs[i];
      }
      return null;
    }

    function init() {
      var wrap = document.getElementById("li-badge-wrap");
      if (!wrap) return;

      // Reposition first, so the badge is never briefly visible in the wrong spot.
      var target = null;
      if (BEFORE_HEADING) {
        target = headingByText(BEFORE_HEADING);
      }
      if (!target && MOVE_BEFORE) {
        var selectors = MOVE_BEFORE.split(",");
        for (var i = 0; i < selectors.length; i++) {
          target = document.querySelector(selectors[i].trim());
          if (target) break;
        }
      }
      if (target && target.parentNode) {
        target.parentNode.insertBefore(wrap, target);
      } else if (APPEND_TO) {
        // Append as the last child, for pages whose body the layout generates.
        var container = null;
        var sels = APPEND_TO.split(",");
        for (var k = 0; k < sels.length; k++) {
          container = document.querySelector(sels[k].trim());
          if (container) break;
        }
        if (container) container.appendChild(wrap);
      }

      var badge = wrap.querySelector(".LI-profile-badge");
      if (badge) {
        var dark = document.documentElement.getAttribute("data-theme") === "dark";
        badge.setAttribute("data-theme", dark ? "dark" : "light");
      }

      wrap.removeAttribute("hidden");

      var s = document.createElement("script");
      s.src = "https://platform.linkedin.com/badges/js/profile.js";
      s.async = true;
      s.defer = true;
      document.head.appendChild(s);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
